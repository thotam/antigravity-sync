{
    "name": "antigravity-sync",
    "displayName": "Antigravity Sync",
    "description": "Sync your Antigravity settings, extensions, keybindings, and snippets across devices using Google Drive",
    "version": "0.7.2",
    "publisher": "thotam",
    "icon": "images/icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/thotam/antigravity-sync"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "sync",
        "settings",
        "extensions",
        "keybindings",
        "snippets",
        "google-drive",
        "profile",
        "antigravity"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "antigravitysync.showDashboard",
                "title": "Open Dashboard",
                "category": "Antigravity Sync"
            }
        ],
        "configuration": {
            "title": "Antigravity Sync",
            "properties": {
                "antigravitysync.excludeExtensions": {
                    "type": "array",
                    "default": [],
                    "description": "Extension IDs to exclude from sync"
                }
            }
        }
    },
    "scripts": {
        "compile": "webpack",
        "compile:tsc": "tsc -p ./",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map"
    },
    "devDependencies": {
        "@types/node": "20.x",
        "@types/vscode": "^1.90.0",
        "@vscode/codicons": "^0.0.36",
        "copy-webpack-plugin": "^12.0.2",
        "dotenv": "^17.3.1",
        "ts-loader": "^9.5.1",
        "typescript": "^5.8.3",
        "webpack": "^5.99.6",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {}
}
